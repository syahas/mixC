{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motion Workbench",
  "version": "0.1.0",
  "identifier": "com.motionworkbench.prototype",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{ "title": "Motion Workbench", "width": 1280, "height": 800, "minWidth": 760, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
